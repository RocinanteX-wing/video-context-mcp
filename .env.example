# All settings are optional; defaults shown.

# Where the index database, transcripts, and extracted frames live.
# VCM_CACHE_DIR=~/.cache/video-context-mcp

# Netscape-format cookies file for yt-dlp (needed for age-restricted /
# members-only videos or when YouTube triggers its bot check).
# YTDLP_COOKIES_FILE=

# Soft cap for the cache directory; list_videos warns when exceeded.
# VCM_MAX_CACHE_GB=20

# Binary overrides (default: resolved from PATH).
# VCM_YTDLP_BIN=yt-dlp
# VCM_FFMPEG_BIN=ffmpeg
# VCM_FFPROBE_BIN=ffprobe
# VCM_TESSERACT_BIN=tesseract
# VCM_WHISPER_BIN=whisper-cli

# Path to a ggml whisper model for whisper_fallback ASR. Unset = auto-download
# ggml-base.en.bin (~148 MB) into the cache on first use.
# VCM_WHISPER_MODEL=

# Embedding model for semantic search (Transformers.js/ONNX; auto-downloads).
# VCM_EMBED_MODEL=Xenova/all-MiniLM-L6-v2

# Visual indexing tuning.
# VCM_MAX_VIDEO_HEIGHT=720
# VCM_SCENE_THRESHOLD=0.3
# VCM_MIN_FRAME_GAP_S=10
# VCM_MAX_FRAMES=500
